...@./hardware-theme
direction: down
host: "Host CPU / SoC (functional placement)" {
  class: chip
  direction: down
  cores: "CPU cores + private caches" {class: block}
  fabric: "Coherent fabric / LLC / home agents" {class: block}
  io: "I/O hardware" {
    class: chip
    direction: right
    root: "PCIe Root Port / RC\nTLP <-> internal transactions" {class: io}
    remap: "IOMMU\nContext cache / IOTLB\nPage walker / permissions" {class: control}
    root -> remap: "DMA requests\nRequester ID + IOVA" {class: bus}
  }
  imc: "Integrated Memory Controller" {class: block}
  cores <-> fabric: "CPU memory accesses" {class: bus}
  io.remap -> fabric: "translated PA + access" {class: bus}
  fabric -> io.root: "MMIO requests / Cpl data" {class: bus}
  fabric <-> imc: "memory transactions" {class: bus}
}
dram: "External Host DRAM\n\nDescriptor ring: DMA 0x10000000\nInput: DMA 0x20000000, 512 B\nI/O page tables at host PA" {class: memory}
fpga: "FPGA card" {
  class: chip
  direction: down
  ip: "PCIe Integrated Block\nPHY / Data Link / Transaction" {class: io}
  dma: "P adapters + A-E DMA/control\nBAR bridge / RQ / RC / IRQ" {class: control}
  local: "G: 16 x 256-bit Input BRAM\nLocal bytes 0x8000-0x81FF" {class: memory}
  npu: "N: NPU + local weights\nInput ownership control" {class: data}
  ip <-> dma: "CQ/CC + RQ/RC\nFPGA internal AXI4-Stream" {class: bus}
  dma -> local: "address + data + byte enable" {class: payload}
  local -> npu: "independent read port" {class: payload}
  dma -> npu: "input task valid/ready" {class: event}
}
host.imc <-> dram: "DDR interface" {class: physical}
host.io.root <-> fpga.ip: "PCIe Link\nMRd / CplD / MemWr" {class: physical}
