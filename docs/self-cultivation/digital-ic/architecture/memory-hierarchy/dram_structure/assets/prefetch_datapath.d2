direction: down
classes: {
  chip: {style: {fill: "#F0F3F7"; stroke: "#697B94"; stroke-width: 2; border-radius: 14; font-size: 30; bold: true}}
  block: {style: {fill: "#FFFFFF"; stroke: "#77879D"; stroke-width: 2; border-radius: 10; font-size: 26}}
  io: {style: {fill: "#E4EEFF"; stroke: "#3974C6"; stroke-width: 2; border-radius: 10; font-size: 26}}
  control: {style: {fill: "#FFF1D8"; stroke: "#B57B21"; stroke-width: 2; border-radius: 10; font-size: 26}}
  data: {style: {fill: "#E0F1E9"; stroke: "#28825D"; stroke-width: 2; border-radius: 10; font-size: 26}}
  memory: {style: {fill: "#EFE8F9"; stroke: "#8260A7"; stroke-width: 2; border-radius: 10; font-size: 26}}
  physical: {style: {stroke: "#3974C6"; stroke-width: 4; font-color: "#255A9E"; font-size: 24; bold: true}}
  bus: {style: {stroke: "#55728F"; stroke-width: 2; font-color: "#334C68"; font-size: 22}}
  payload: {style: {stroke: "#28825D"; stroke-width: 3; font-color: "#1A6849"; font-size: 22}}
  event: {style: {stroke: "#B57B21"; stroke-width: 2; stroke-dash: 4; font-color: "#8B5C14"; font-size: 22}}
}

array: "存储阵列（Bank）" {
    class: memory
}

buffer: "寄存器阵列暂存" {
    class: data
}

mux: "8:1 多路复用器" {
    class: chip
}

pins: "8 根 DQ 引脚" {
    class: io
}

bus: "外部数据总线" {
    class: bus
}

array -> buffer: "一次列访问，并行读出64位（内部总线位宽64）" {
    class: payload
}

buffer -> mux

mux -> pins: "每拍选择 8 位" {
    class: payload
}

pins -> bus: "分 8 拍串行输出" {
    class: payload
}